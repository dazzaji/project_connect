{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ilp:schema:discovery:v2",
  "title": "ILP instance discovery document (/.well-known/interlateral.json) — R-CORE-20, R-CORE-30..33",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "required": [
    "protocol",
    "protocols",
    "spec_versions",
    "instance",
    "keys",
    "endpoints",
    "packs",
    "federation"
  ],
  "properties": {
    "protocol": {
      "const": "ilp/1"
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ilp/[0-9]+$"
      }
    },
    "spec_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "required": [
        "host",
        "name",
        "software",
        "deployment_id"
      ],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "operator_contact": {
          "type": "string"
        },
        "federation_policy_url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "required": [
            "name",
            "version",
            "build"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "build": {
              "type": "string",
              "minLength": 1,
              "$comment": "immutable identifier of the running code (R-CORE-30)"
            }
          }
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {}
        },
        "required": [
          "kid",
          "kty",
          "crv",
          "x",
          "use"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "minLength": 1
          },
          "kty": {
            "const": "OKP"
          },
          "crv": {
            "const": "Ed25519"
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 43,
            "maxLength": 43
          },
          "use": {
            "const": "sig"
          },
          "not_after": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "$comment": "Exactly one key is active (R-CORE-34(d)); the active kid is `federation.active_kid`."
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "required": [
        "api",
        "federation",
        "directory",
        "revocations"
      ],
      "properties": {
        "api": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "federation": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "directory": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "revocations": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {}
        },
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "compatible_versions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            }
          }
        }
      }
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "required": [
        "mode",
        "join_requests",
        "revocation_bound_s",
        "active_kid"
      ],
      "properties": {
        "mode": {
          "enum": [
            "allowlist"
          ]
        },
        "join_requests": {
          "type": "boolean"
        },
        "revocation_bound_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "active_kid": {
          "type": "string",
          "minLength": 1,
          "$comment": "SCR-3: the single active signing key (R-CORE-34(d))"
        },
        "conformance_mode": {
          "enum": [
            "production",
            "certification"
          ]
        }
      }
    },
    "current_event": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "required": [
        "slug",
        "title",
        "url"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "skill_md": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        }
      }
    }
  }
}
