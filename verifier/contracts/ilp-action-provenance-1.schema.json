{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ilp:export:action-provenance:1",
  "title": "Beta additive export action provenance row, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "action", "intent", "mandate_source", "receipt", "receipt_hash", "authorization_grant", "grant_jws_sha256"],
  "properties": {
    "format": { "const": "ilp-action-provenance/1" },
    "action": { "type": "string", "pattern": "^ilp:[^:]+:action:[^:]+$" },
    "intent": { "type": ["string", "null"] },
    "mandate_source": { "enum": ["caller", "default", null] },
    "receipt": { "type": "string", "pattern": "^ilp:[^:]+:receipt:[^:]+$" },
    "receipt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorization_grant": { "type": ["string", "null"] },
    "grant_jws_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  },
  "oneOf": [
    { "properties": { "authorization_grant": { "type": "null" }, "grant_jws_sha256": { "type": "null" } } },
    { "properties": { "authorization_grant": { "type": "string", "minLength": 1 }, "grant_jws_sha256": { "type": "string" } } }
  ],
  "$defs": {
    "revisionRow": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "artifact", "rev", "mandate_source"],
      "properties": {
        "format": { "const": "ilp-revision-provenance/1" },
        "artifact": { "type": "string", "pattern": "^ilp:[^:]+:artifact:[^:]+$" },
        "rev": { "type": "integer", "minimum": 0 },
        "mandate_source": { "enum": ["caller", "default", null] }
      }
    }
  }
}
