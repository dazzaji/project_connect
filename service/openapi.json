{
  "openapi": "3.1.0",
  "info": {
    "title": "Project Connect job service",
    "version": "0.1.0",
    "description": "Authenticated job/status/results API that runs the Project Connect conformance runner against registered targets. See service/README.md."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4300",
      "description": "loopback only; expose through a reviewed proxy"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "security": [],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "ready"
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "summary": "Submit a job (submitter, admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "invalid request (unknown member, profile, gate, target id or role, reps, also)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "missing or unknown bearer token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "body over max_request_bytes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "queue full",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "summary": "Job status (owner, admin)",
        "responses": {
          "200": {
            "description": "job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "unknown job, or not visible to the caller",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}/results": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "summary": "Sanitized results report (owner, admin)",
        "responses": {
          "200": {
            "description": "report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "unknown job",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "job not terminal yet",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "post": {
        "summary": "Cancel (owner, admin): queued \u2192 cancelled; running \u2192 SIGTERM then SIGKILL to the verified runner group",
        "responses": {
          "202": {
            "description": "cancellation accepted"
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "unknown job",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "job is already terminal",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API principal token (stored by the service only as SHA-256)"
      }
    },
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        }
      }
    },
    "schemas": {
      "JobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "pairs"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "examples": [
              "pc-0.1-s1"
            ]
          },
          "gate": {
            "enum": [
              "SG-2",
              "SG-3",
              "all"
            ],
            "default": "SG-2"
          },
          "pairs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "home",
                "host"
              ],
              "properties": {
                "home": {
                  "type": "string",
                  "description": "registered target id with role home"
                },
                "host": {
                  "type": "string",
                  "description": "registered target id with role host"
                }
              }
            }
          },
          "reps": {
            "type": "integer",
            "minimum": 1,
            "description": "bounded by limits.max_reps"
          },
          "also": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "description": "test id of the profile"
            }
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "starting",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted",
              "timed_out"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "structural code; redacted and bounded"
          },
          "request": {
            "$ref": "#/components/schemas/JobRequest"
          },
          "composition": {
            "type": "object",
            "properties": {
              "service_commit": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "git commit of the service tree, or null when not run from a git checkout (e.g. a standalone export)"
              },
              "package_lock_sha256": {
                "type": "string"
              },
              "runner_node_sha256": {
                "type": "string"
              },
              "runner_entry_sha256": {
                "type": "string"
              },
              "profile_sha256": {
                "type": "string"
              },
              "target_descriptor_sha256": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "qualification": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Qualification"
              },
              {
                "type": "null"
              }
            ],
            "description": "set when the job is terminal (scope, full_profile_qualified, reasons)"
          }
        }
      },
      "Report": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "counts": {
            "type": "object",
            "properties": {
              "pass": {
                "type": "integer"
              },
              "fail": {
                "type": "integer"
              },
              "not_applicable": {
                "type": "integer"
              }
            }
          },
          "redacted": {
            "type": "boolean"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "test_id": {
                  "type": "string"
                },
                "requirement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scenario": {
                  "type": "string",
                  "description": "home:host"
                },
                "repetition": {
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "examples": [
                    "CAPABILITY_ABSENT",
                    "NOT_APPLICABLE_TO_PAIR",
                    "TEST_FAILED",
                    "NOT_SUPPORTED_BY_SERVICE_RUNNER",
                    "SETUP_FAILED",
                    "TRUST_ROOTS_NOT_CONFIGURED",
                    "DERIVED_VERDICT_UNSUPPORTED_FOR_PAIR",
                    "NOT_APPLICABLE_TO_SCENARIO"
                  ]
                },
                "detail": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "qualification": {
            "$ref": "#/components/schemas/Qualification"
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "examples": [
              "urn:connect:error:BAD_REQUEST"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      },
      "Qualification": {
        "type": "object",
        "description": "Profile qualification, distinct from job success: full_profile only when every profile test was selected and every row passed",
        "properties": {
          "scope": {
            "enum": [
              "partial",
              "full_profile"
            ]
          },
          "full_profile_qualified": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "enum": [
                "JOB_NOT_SUCCEEDED",
                "PROFILE_UNKNOWN",
                "PROFILE_TESTS_NOT_SELECTED",
                "NOT_APPLICABLE_ROWS",
                "FAILED_ROWS",
                "RUN_RECORD_MISSING",
                "PROFILE_DIGEST_MISMATCH",
                "COMPOSITION_MISSING"
              ]
            }
          },
          "not_selected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_applicable": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
